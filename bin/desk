#!/usr/bin/env bash
#
# desk - build the default terminal layout
#
# Dispatches to desk-rex or desk-herdr, passing the remaining arguments on.

set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/Code/hiradp/home}"
source "$DOTFILES/lib/log.sh"

usage() {
  cat <<'EOF_USAGE'
desk - build the default terminal layout

Usage: desk [--rex | --herdr] [stop]

--rex    Build the Rex session (default).
--herdr  Open the Herdr sessions, one Ghostty tab each.

stop     Tear down what the chosen backend built.
EOF_USAGE
}

backend=rex
args=()
for arg in "$@"; do
  case "$arg" in
  --rex) backend=rex ;;
  --herdr) backend=herdr ;;
  -h | --help)
    usage
    exit 0
    ;;
  -*)
    usage >&2
    log_error "desk: unknown flag: $arg"
    exit 1
    ;;
  *) args+=("$arg") ;;
  esac
done

exec "$DOTFILES/bin/desk-$backend" ${args[@]+"${args[@]}"}
