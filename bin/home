#!/usr/bin/env bash

set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/Code/hiradp/home}"
DEFAULT_FOLDERS="atuin claude fish ghostty git nvim starship tmux yazi"

# Source logging library
source "$DOTFILES/lib/log.sh"

# ------------------------------------------------------------------------------
# Commands
# ------------------------------------------------------------------------------

cmd_link() {
  local folders="${*:-$DEFAULT_FOLDERS}"
  local stow="/opt/homebrew/bin/stow"

  for folder in $folders; do
    log_info "Linking $folder..."
    $stow -d "$DOTFILES/config" -D "$folder" 2>/dev/null || true
    $stow -d "$DOTFILES/config" "$folder" -t "$HOME"
  done

  log_ok "Linked"
}

cmd_install() {
  local with_work=false
  local positional=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --work)
      with_work=true
      shift
      ;;
    *)
      positional+=("$1")
      shift
      ;;
    esac
  done

  local type="${positional[0]:-all}"

  case "$type" in
  essentials)
    _tap_from_file "$DOTFILES/pkg/brew/taps"
    _install_from_file "$DOTFILES/pkg/brew/essentials"
    ;;
  casks)
    _install_from_file "$DOTFILES/pkg/brew/cask" --cask
    ;;
  langs)
    _install_langs
    ;;
  all)
    _tap_from_file "$DOTFILES/pkg/brew/taps"
    _install_from_file "$DOTFILES/pkg/brew/essentials"
    _install_from_file "$DOTFILES/pkg/brew/cask" --cask
    _install_langs
    ;;
  *)
    log_error "Unknown install type: $type"
    log_info "Valid types: essentials, casks, langs, all"
    exit 1
    ;;
  esac

  if [[ "$with_work" == true ]]; then
    log_section "Installing work"
    _run_work install
  fi

  log_ok "Installed"
}

cmd_setup() {
  log_banner "Home Setup"

  log_section "Installing Homebrew"
  _install_homebrew

  log_section "Setting up SSH keys"
  _setup_ssh

  log_section "Configuring remotes"
  _setup_remotes

  log_section "Installing brew packages"
  cmd_install

  log_section "Linking dotfiles"
  cmd_link

  log_banner "Setup complete"
}

cmd_upgrade() {
  local with_work=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --work)
      with_work=true
      shift
      ;;
    *) shift ;;
    esac
  done

  log_banner "Home Upgrade"

  log_section "Pulling latest"
  git -C "$DOTFILES" pull --ff-only
  log_ok "Up to date"

  log_section "Upgrading brew packages"
  brew update
  brew upgrade
  log_ok "Brew packages upgraded"

  log_section "Upgrading Neovim plugins"
  nvim --headless "+Lazy! sync" +qa
  log_ok "Neovim plugins upgraded"

  if [[ "$with_work" == true ]]; then
    log_section "Upgrading work"
    _run_work upgrade
  fi

  log_section "Committing changes"
  if [[ -z "$(git -C "$DOTFILES" status --porcelain)" ]]; then
    log_dim "Nothing to commit"
  else
    git -C "$DOTFILES" add -A
    git -C "$DOTFILES" commit -m "chore: upgrade"
    git -C "$DOTFILES" push
    log_ok "Changes committed and pushed"
  fi

  log_banner "Upgrade complete"
}

cmd_connect() {
  local zt_file="$HOME/Library/Mobile Documents/com~apple~CloudDocs/Home/zerotier-network-id"

  if [[ ! -f "$zt_file" ]]; then
    log_dim "ZeroTier network ID file not found, skipping"
    return 0
  fi

  local network_id
  network_id=$(<"$zt_file")

  if [[ -z "$network_id" ]]; then
    log_warn "ZeroTier network ID file is empty"
    return 1
  fi

  log_info "Connecting to ZeroTier network..."
  sudo zerotier-cli join "$network_id"
  log_ok "Connected to ZeroTier network"
}

cmd_help() {
  cat <<EOF
home - dotfiles manager

Usage: home <command> [args]

Commands:
  setup                 First-time setup (install + link)
  install [type]        Install packages (essentials, casks, langs, all)
  link [folders...]     Link configs to ~ using stow (default: all)
  upgrade               Upgrade brew packages and Neovim plugins, then commit + push
  connect               Connect to ZeroTier network (ID from iCloud)
  help                  Show this help message

Flags:
  --work                Also run the matching work command (install or upgrade only)

Environment:
  DOTFILES              Path to dotfiles repo (default: ~/Code/hiradp/home)
  WORK_DIR              Path to work repo (default: ~/Code/hiradp/work)

Examples:
  home setup                First-time machine setup
  home install              Install all packages
  home install --work       Install all packages, then run 'work install'
  home install essentials   Install only CLI tools
  home install casks        Install only GUI apps
  home install langs        Install language runtimes (bun, go, python, ruby, rust, zig)
  home upgrade              Upgrade brew + nvim plugins, commit + push changes
  home upgrade --work       Upgrade home, then run 'work upgrade'
  home link                 Link all config folders
  home link nvim fish       Link only nvim and fish configs
EOF
}

# ------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------

_install_homebrew() {
  if command -v brew &>/dev/null; then
    log_info "Already installed"
  else
    log_info "Installing..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    log_ok "Installed"
  fi
  eval "$(/opt/homebrew/bin/brew shellenv)"
}

_setup_ssh() {
  local ssh_dir="$HOME/.ssh"
  local vault_dir="$HOME/Library/Mobile Documents/com~apple~CloudDocs/Documents/Vault"
  local config_file="$ssh_dir/config"

  mkdir -p "$ssh_dir"

  if [[ -f "$ssh_dir/id_ed25519" ]]; then
    log_info "SSH keys already exist"
  else
    if [[ -f "$vault_dir/id_ed25519" ]]; then
      cp "$vault_dir/id_ed25519" "$ssh_dir/id_ed25519"
      cp "$vault_dir/id_ed25519.pub" "$ssh_dir/id_ed25519.pub"
      chmod 600 "$ssh_dir/id_ed25519"
      chmod 644 "$ssh_dir/id_ed25519.pub"
      log_ok "SSH keys copied from iCloud"
    else
      log_warn "SSH keys not found in iCloud vault"
      log_dim "Expected: $vault_dir"
      return 0
    fi
  fi

  if ! grep -q "UseKeychain yes" "$config_file" 2>/dev/null; then
    cat >>"$config_file" <<EOF

Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
EOF
    chmod 600 "$config_file"
    log_info "SSH config updated for Apple Keychain"
  fi

  ssh-add --apple-use-keychain "$ssh_dir/id_ed25519" 2>/dev/null || true
}

_tap_from_file() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  while IFS= read -r tap || [[ -n "$tap" ]]; do
    [[ -z "$tap" || "$tap" =~ ^# ]] && continue
    log_dim "Tapping $tap..."
    if ! brew tap "$tap" </dev/null; then
      log_warn "Failed to tap $tap"
    fi
  done <"$file"
}

_install_from_file() {
  local file="$1"
  local flag="${2:-}"

  if [[ ! -f "$file" ]]; then
    log_error "File not found: $file"
    exit 1
  fi

  while IFS= read -r package || [[ -n "$package" ]]; do
    [[ -z "$package" || "$package" =~ ^# ]] && continue
    log_dim "Installing $package..."
    if ! brew install $flag "$package" </dev/null; then
      log_warn "Failed to install $package (may already exist outside Homebrew)"
    fi
  done <"$file"
}

_setup_remotes() {
  local private_url="git@github.com:hiradp/home-private.git"
  local public_url="git@github.com:hiradp/home.git"

  if git ls-remote "$private_url" HEAD &>/dev/null; then
    git -C "$DOTFILES" remote set-url origin "$private_url"
    if git -C "$DOTFILES" remote | grep -qx upstream; then
      git -C "$DOTFILES" remote set-url upstream "$public_url"
    else
      git -C "$DOTFILES" remote add upstream "$public_url"
    fi
    log_ok "origin → home-private, upstream → home"

    log_info "Pulling from origin/main..."
    git -C "$DOTFILES" fetch origin
    if git -C "$DOTFILES" pull --ff-only origin main; then
      git -C "$DOTFILES" branch --set-upstream-to=origin/main main &>/dev/null || true
      log_ok "Up to date with origin/main"
    else
      log_warn "Could not fast-forward to origin/main"
    fi
  else
    git -C "$DOTFILES" remote set-url origin "$public_url"
    log_dim "No access to home-private; origin → home"
  fi
}

_install_langs() {
  log_info "Installing language runtimes..."
  for script in "$DOTFILES/pkg/lang"/*; do
    [[ -f "$script" ]] || continue
    log_dim "$(basename "$script")"
    source "$script"
  done
}

_run_work() {
  local work="${WORK_DIR:-$HOME/Code/hiradp/work}/bin/work"
  if [[ ! -x "$work" ]]; then
    log_error "work CLI not found at $work"
    return 1
  fi
  "$work" "$@"
}

# ------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------

main() {
  local cmd="${1:-help}"
  shift || true

  case "$cmd" in
  setup) cmd_setup ;;
  install) cmd_install "$@" ;;
  link) cmd_link "$@" ;;
  upgrade) cmd_upgrade ;;
  connect) cmd_connect ;;
  help | --help | -h) cmd_help ;;
  *)
    log_error "Unknown command: $cmd"
    cmd_help
    exit 1
    ;;
  esac
}

main "$@"
