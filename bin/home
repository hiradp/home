#!/usr/bin/env bash

set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/Code/hiradp/home}"
BOTS_DIR="${BOTS_DIR:-$HOME/Code/hiradp/bots}"
BOTS_REPO="${BOTS_REPO:-git@github.com:hiradp/bots.git}"
DEFAULT_FOLDERS="atuin bots fish ghostty git nvim rex starship tmux zed"

# Source shared libraries
source "$DOTFILES/lib/log.sh"
source "$DOTFILES/lib/pkg.sh"

# ------------------------------------------------------------------------------
# Commands
# ------------------------------------------------------------------------------

cmd_link() {
  local folders="${*:-$DEFAULT_FOLDERS}"
  local stow="/opt/homebrew/bin/stow"

  for folder in $folders; do
    case "$folder" in
    bots)
      log_info "Linking bots..."
      _run_bots link
      continue
      ;;
    esac

    log_info "Linking $folder..."
    $stow -d "$DOTFILES/config" --ignore='\.DS_Store' -D "$folder" -t "$HOME" 2>/dev/null || true
    $stow -d "$DOTFILES/config" --ignore='\.DS_Store' "$folder" -t "$HOME"
  done

  log_ok "Linked"
}

cmd_install() {
  local type="${1:-all}"

  case "$type" in
  essentials)
    pkg_install_from_file "$DOTFILES/pkg/brew/essentials"
    ;;
  casks)
    pkg_install_from_file "$DOTFILES/pkg/brew/cask" --cask
    ;;
  langs)
    _install_langs
    ;;
  tools)
    _install_tools
    ;;
  all)
    pkg_install_from_file "$DOTFILES/pkg/brew/essentials"
    pkg_install_from_file "$DOTFILES/pkg/brew/cask" --cask
    _install_langs
    _install_tools
    ;;
  *)
    log_error "Unknown install type: $type"
    log_info "Valid types: essentials, casks, langs, tools, all"
    exit 1
    ;;
  esac

  if _has_work; then
    log_section "Installing work"
    _run_work install
  fi

  log_ok "Installed"
}

cmd_setup() {
  log_banner "Home Setup"

  log_section "Installing Homebrew"
  _install_homebrew

  log_section "Setting up SSH keys"
  _setup_ssh

  log_section "Configuring remotes"
  _setup_remotes

  log_section "Cloning bots"
  _setup_bots

  log_section "Installing brew packages"
  cmd_install

  log_section "Setting up bots"
  _run_bots setup

  log_section "Linking dotfiles"
  cmd_link

  log_banner "Setup complete"
}

cmd_upgrade() {
  log_banner "Home Upgrade"

  log_section "Pulling latest"
  git -C "$DOTFILES" pull --ff-only
  log_ok "Up to date"

  log_section "Upgrading bots"
  _setup_bots
  _run_bots upgrade

  log_section "Upgrading brew packages"
  brew update
  brew upgrade
  log_ok "Brew packages upgraded"

  log_section "Upgrading Neovim plugins"
  nvim --headless "+Lazy! sync" +qa
  log_ok "Neovim plugins upgraded"

  if _has_work; then
    log_section "Upgrading work"
    _run_work upgrade
  fi

  log_section "Committing Neovim plugin lockfile"
  local lazy_lock="config/nvim/.config/nvim/lazy-lock.json"
  if git -C "$DOTFILES" diff --quiet HEAD -- "$lazy_lock"; then
    log_dim "Nothing to commit"
  else
    # Commit only the lockfile from the working tree. `--only` deliberately
    # excludes every other path, including changes already staged by the user.
    git -C "$DOTFILES" commit --only -m "chore: upgrade" -- "$lazy_lock"
    git -C "$DOTFILES" push
    log_ok "Neovim plugin lockfile committed and pushed"
  fi

  log_banner "Upgrade complete"
}

cmd_connect() {
  local zt_file="$HOME/Library/Mobile Documents/com~apple~CloudDocs/Home/zerotier-network-id"

  if [[ ! -f "$zt_file" ]]; then
    log_dim "ZeroTier network ID file not found, skipping"
    return 0
  fi

  local network_id
  network_id=$(<"$zt_file")

  if [[ -z "$network_id" ]]; then
    log_warn "ZeroTier network ID file is empty"
    return 1
  fi

  log_info "Connecting to ZeroTier network..."
  sudo zerotier-cli join "$network_id"
  log_ok "Connected to ZeroTier network"
}

cmd_help() {
  cat <<EOF
home - dotfiles manager

Usage: home <command> [args]

Commands:
  setup                 First-time setup (install + link)
  install [type]        Install packages (essentials, casks, langs, tools, all)
  link [folders...]     Link configs to ~ using stow (default: all)
  upgrade               Upgrade brew + Neovim, then commit + push lazy-lock.json
  connect               Connect to ZeroTier network (ID from iCloud)
  help                  Show this help message

Environment:
  DOTFILES              Path to dotfiles repo (default: ~/Code/hiradp/home)
  BOTS_DIR              Path to agent config repo (default: ~/Code/hiradp/bots)
  BOTS_REPO             Agent config clone URL (default: git@github.com:hiradp/bots.git)
  WORK_DIR              Path to work repo (default: ~/Code/planetscale)

Examples:
  home setup                First-time machine setup
  home install              Install all packages (and work, if present)
  home install essentials   Install only CLI tools
  home install casks        Install only GUI apps
  home install langs        Install language runtimes (go, rust, zig)
  home install tools        Install standalone tools (cursor)
  home upgrade              Upgrade brew + nvim, commit + push lazy-lock.json
  home link                 Link all config folders
  home link nvim fish       Link only nvim and fish configs
EOF
}

# ------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------

_install_homebrew() {
  if command -v brew &>/dev/null; then
    log_info "Already installed"
  else
    log_info "Installing..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    log_ok "Installed"
  fi
  eval "$(/opt/homebrew/bin/brew shellenv)"
}

_setup_ssh() {
  local ssh_dir="$HOME/.ssh"
  local vault_dir="$HOME/Library/Mobile Documents/com~apple~CloudDocs/Home/vault/ssh"
  local config_file="$ssh_dir/config"

  mkdir -p "$ssh_dir"

  if [[ -f "$ssh_dir/id_ed25519" ]]; then
    log_info "SSH keys already exist"
  else
    if [[ -f "$vault_dir/id_ed25519" ]]; then
      cp "$vault_dir/id_ed25519" "$ssh_dir/id_ed25519"
      cp "$vault_dir/id_ed25519.pub" "$ssh_dir/id_ed25519.pub"
      chmod 600 "$ssh_dir/id_ed25519"
      chmod 644 "$ssh_dir/id_ed25519.pub"
      log_ok "SSH keys copied from iCloud"
    else
      log_warn "SSH keys not found in iCloud vault"
      log_dim "Expected: $vault_dir"
      return 0
    fi
  fi

  if ! grep -q "UseKeychain yes" "$config_file" 2>/dev/null; then
    cat >>"$config_file" <<EOF

Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
EOF
    chmod 600 "$config_file"
    log_info "SSH config updated for Apple Keychain"
  fi

  ssh-add --apple-use-keychain "$ssh_dir/id_ed25519" 2>/dev/null || true
}

_setup_bots() {
  if [[ -d "$BOTS_DIR/.git" ]]; then
    log_info "Repo exists at $BOTS_DIR"
    return 0
  fi
  if [[ -e "$BOTS_DIR" ]]; then
    log_error "Bots path exists but is not a Git repo: $BOTS_DIR"
    return 1
  fi

  mkdir -p "$(dirname "$BOTS_DIR")"
  git clone "$BOTS_REPO" "$BOTS_DIR"
  log_ok "Cloned to $BOTS_DIR"
}

_setup_remotes() {
  local private_url="git@github.com:hiradp/home-private.git"
  local public_url="git@github.com:hiradp/home.git"

  if git ls-remote "$private_url" HEAD &>/dev/null; then
    git -C "$DOTFILES" remote set-url origin "$private_url"
    if git -C "$DOTFILES" remote | grep -qx public; then
      git -C "$DOTFILES" remote set-url public "$public_url"
    else
      git -C "$DOTFILES" remote add public "$public_url"
    fi
    log_ok "origin → home-private, public → home"

    log_info "Pulling from origin/main..."
    git -C "$DOTFILES" fetch origin
    if git -C "$DOTFILES" pull --ff-only origin main; then
      git -C "$DOTFILES" branch --set-upstream-to=origin/main main &>/dev/null || true
      log_ok "Up to date with origin/main"
    else
      log_warn "Could not fast-forward to origin/main"
    fi
  else
    git -C "$DOTFILES" remote set-url origin "$public_url"
    log_dim "No access to home-private; origin → home"
  fi
}

_install_langs() {
  log_info "Installing language runtimes..."
  pkg_source_dir "$DOTFILES/pkg/lang"
}

_install_tools() {
  log_info "Installing tools..."
  pkg_source_dir "$DOTFILES/pkg/tool"
}

_work_bin() {
  echo "${WORK_DIR:-$HOME/Code/planetscale}/bin/work"
}

_has_work() {
  [[ -x "$(_work_bin)" ]]
}

_run_work() {
  "$(_work_bin)" "$@"
}

_run_bots() {
  local bots_dir="$BOTS_DIR"
  BOTS_DIR="$bots_dir" HOME_DIR="$DOTFILES" "$bots_dir/bin/bots" "$@"
}

# ------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------

main() {
  local cmd="${1:-help}"
  shift || true

  case "$cmd" in
  setup) cmd_setup ;;
  install) cmd_install "$@" ;;
  link) cmd_link "$@" ;;
  upgrade) cmd_upgrade ;;
  connect) cmd_connect ;;
  help | --help | -h) cmd_help ;;
  *)
    log_error "Unknown command: $cmd"
    cmd_help
    exit 1
    ;;
  esac
}

main "$@"
