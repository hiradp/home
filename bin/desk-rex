#!/usr/bin/env bash
#
# desk-rex - build the default Rex session
#
# Idempotent: creates the session and whatever tabs are missing, and leaves
# everything that already exists alone.

set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/Code/hiradp/home}"
source "$DOTFILES/lib/log.sh"

SESSION="main"

# Rex's CLI starts the login shell, which is zsh; the terminals here run fish.
PANE_SHELL="/opt/homebrew/bin/fish"

# tab label|directory[|directory...]
# Each extra directory becomes a pane to the right, all the same width.
TABS=(
  "🏡 hiradp|$HOME/Code/hiradp/home|$HOME/Code/hiradp/bots|$HOME/Code/hiradp/git-forest"
  "🪐 planetscale|$HOME/Code/planetscale"
  "🕵️‍♀️ psprobe|$HOME/Code/planetscale/lib/psprobe"
  "👀 review|$HOME/Code/planetscale/src/.reviews"
)

usage() {
  cat <<'EOF'
desk-rex - build the default Rex session

Usage: desk-rex [stop]

Creates the main session and any of its tabs that are missing. Safe to
run at any time.

stop  Kill the main session, terminating its commands. Repository files
      are untouched.
EOF
}

fail() {
  log_error "desk-rex: $*"
  exit 1
}

(($# <= 1)) || fail "expected at most one argument"

case "${1:-}" in
"" | stop) ;;
-h | --help)
  usage
  exit 0
  ;;
*)
  usage >&2
  fail "unknown argument: $1"
  ;;
esac

command -v rex >/dev/null 2>&1 || fail "rex is not installed"
command -v jq >/dev/null 2>&1 || fail "jq is not installed"
[[ -x "$PANE_SHELL" ]] || fail "fish is not installed"

session_exists() {
  rex ls --json | jq -e --arg label "$SESSION" \
    '.sessions[] | select(.label == $label)' >/dev/null
}

if [[ ${1:-} == stop ]]; then
  log_section "Resetting session"
  if session_exists; then
    rex kill "$SESSION" >/dev/null
    log_ok "killed $SESSION"
  else
    log_dim "$SESSION is not running"
  fi
  exit 0
fi

tab_count() {
  rex window ls -s "$SESSION" --json |
    jq --arg label "$1" '[.windows[] | select(.label == $label)] | length'
}

# The first directory already has a pane; split the newest pane for each of
# the rest, giving the new one all but one share of what is left.
add_panes() {
  local block=$1
  shift
  local remaining=$#
  local dir

  rex block rename -s "$SESSION" "$block" "$(basename "$1")" >/dev/null
  shift
  for dir in "$@"; do
    remaining=$((remaining - 1))
    block=$(rex split -s "$SESSION" -b "$block" --cwd "$dir" \
      --ratio $((100 * remaining / (remaining + 1))) \
      --label "$(basename "$dir")" --focus=false --json -- "$PANE_SHELL" |
      jq -r '.block_ids[0]')
  done
}

ensure_tab() {
  local label=$1
  shift
  local dir block count

  for dir in "$@"; do
    [[ -d "$dir" ]] || fail "directory not found: $dir"
  done

  if session_exists; then
    count=$(tab_count "$label")
    ((count > 1)) && fail "multiple '$label' tabs in session $SESSION"
    if ((count == 1)); then
      log_dim "$label already open"
      return
    fi
    block=$(rex window new -s "$SESSION" "$label" --cwd "$1" --focus=false --json \
      -- "$PANE_SHELL" | jq -r '.block_ids[0]')
  else
    block=$(rex new "$SESSION" --window "$label" --cwd "$1" --json \
      -- "$PANE_SHELL" | jq -r '.initial_windows[0].block_ids[0]')
    log_ok "started session $SESSION"
  fi

  (($# > 1)) && add_panes "$block" "$@"
  log_ok "created $label"
}

log_section "Tabs"
for entry in "${TABS[@]}"; do
  IFS='|' read -r -a fields <<<"$entry"
  ensure_tab "${fields[@]}"
done
