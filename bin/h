#!/usr/bin/env bash

set -euo pipefail

HERDR_BIN="${HERDR_BIN:-herdr}"
JQ_BIN="${JQ_BIN:-jq}"
RESET=false
YES=false

usage() {
  cat <<'EOF'
h - open the standard Herdr workspace layout

Usage: h [options]

Options:
  -r, --reset  Close and recreate the managed workspaces
  -y, --yes    Skip reset confirmation
  -h, --help   Show this help

Managed layout:
  hiradp
    home        ~/Code/hiradp/home
    pi-config   ~/Code/hiradp/pi-config
    git-forest  ~/Code/hiradp/git-forest
  planetscale
    main        ~/Code/planetscale
  psprobe
    main        ~/Code/planetscale/lib/psprobe
EOF
}

fail() {
  echo "h: $*" >&2
  exit 1
}

while (($#)); do
  case "$1" in
  -r | --reset) RESET=true ;;
  -y | --yes) YES=true ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    fail "unknown option: $1"
    ;;
  esac
  shift
done

$YES && ! $RESET && fail "--yes requires --reset"
[[ "${HERDR_ENV:-}" != 1 ]] || fail "run h from a shell outside Herdr"
command -v "$HERDR_BIN" >/dev/null 2>&1 || fail "herdr is not installed"
command -v "$JQ_BIN" >/dev/null 2>&1 || fail "jq is not installed"

HOME_DIR="$HOME/Code/hiradp/home"
PI_CONFIG_DIR="$HOME/Code/hiradp/pi-config"
GIT_FOREST_DIR="$HOME/Code/hiradp/git-forest"
PLANETSCALE_DIR="$HOME/Code/planetscale"
PSPROBE_DIR="$HOME/Code/planetscale/lib/psprobe"

for dir in \
  "$HOME_DIR" \
  "$PI_CONFIG_DIR" \
  "$GIT_FOREST_DIR" \
  "$PLANETSCALE_DIR" \
  "$PSPROBE_DIR"; do
  [[ -d "$dir" ]] || fail "directory not found: $dir"
done

server_running() {
  "$HERDR_BIN" status server --json 2>/dev/null |
    "$JQ_BIN" -e '.running == true' >/dev/null 2>&1
}

start_server() {
  server_running && return

  "$HERDR_BIN" server >/dev/null 2>&1 &
  for _ in {1..50}; do
    server_running && return
    sleep 0.1
  done

  fail "Herdr server did not start"
}

workspace_list() {
  "$HERDR_BIN" workspace list
}

workspace_id() {
  local label=$1
  local snapshot count
  snapshot=$(workspace_list)
  count=$("$JQ_BIN" -r --arg label "$label" \
    "[.result.workspaces[] | select(.label == \$label)] | length" <<<"$snapshot")

  if ((count > 1)); then
    fail "multiple '$label' workspaces found; use h --reset"
  fi

  "$JQ_BIN" -r --arg label "$label" \
    ".result.workspaces[] | select(.label == \$label) | .workspace_id" <<<"$snapshot"
}

ensure_workspace() {
  local label=$1
  local cwd=$2
  local first_tab=$3
  local id created tab_id

  id=$(workspace_id "$label")
  if [[ -n "$id" ]]; then
    printf '%s\n' "$id"
    return
  fi

  created=$("$HERDR_BIN" workspace create \
    --label "$label" --cwd "$cwd" --no-focus)
  id=$("$JQ_BIN" -r '.result.workspace.workspace_id' <<<"$created")
  tab_id=$("$JQ_BIN" -r '.result.tab.tab_id' <<<"$created")
  "$HERDR_BIN" tab rename "$tab_id" "$first_tab" >/dev/null
  printf '%s\n' "$id"
}

ensure_tab() {
  local workspace=$1
  local label=$2
  local cwd=$3
  local snapshot count created

  snapshot=$("$HERDR_BIN" tab list --workspace "$workspace")
  count=$("$JQ_BIN" -r --arg label "$label" \
    "[.result.tabs[] | select(.label == \$label)] | length" <<<"$snapshot")

  if ((count > 1)); then
    fail "multiple '$label' tabs found in $workspace; use h --reset"
  fi

  if ((count == 1)); then
    "$JQ_BIN" -r --arg label "$label" \
      ".result.tabs[] | select(.label == \$label) | .tab_id" <<<"$snapshot"
    return
  fi

  created=$("$HERDR_BIN" tab create --workspace "$workspace" \
    --label "$label" --cwd "$cwd" --no-focus)
  "$JQ_BIN" -r '.result.tab.tab_id' <<<"$created"
}

confirm_reset() {
  $YES && return
  [[ -t 0 ]] || fail "reset requires confirmation; pass --yes"

  echo "This will close every pane and process in these workspaces:"
  echo "  hiradp, planetscale, psprobe"
  read -r -p "Reset them? [y/N] " reply
  case "$reply" in
  y | Y | yes | YES) ;;
  *) exit 0 ;;
  esac
}

reset_workspaces() {
  local snapshot
  snapshot=$(workspace_list)

  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    "$HERDR_BIN" workspace close "$id" >/dev/null
  done < <("$JQ_BIN" -r '
    .result.workspaces[]
    | select(.label == "hiradp" or .label == "planetscale" or .label == "psprobe")
    | .workspace_id
  ' <<<"$snapshot")
}

start_server

if $RESET; then
  confirm_reset
  reset_workspaces
fi

hiradp_id=$(ensure_workspace hiradp "$HOME_DIR" home)
home_tab_id=$(ensure_tab "$hiradp_id" home "$HOME_DIR")
ensure_tab "$hiradp_id" pi-config "$PI_CONFIG_DIR" >/dev/null
ensure_tab "$hiradp_id" git-forest "$GIT_FOREST_DIR" >/dev/null

planetscale_id=$(ensure_workspace planetscale "$PLANETSCALE_DIR" main)
ensure_tab "$planetscale_id" main "$PLANETSCALE_DIR" >/dev/null

psprobe_id=$(ensure_workspace psprobe "$PSPROBE_DIR" main)
ensure_tab "$psprobe_id" main "$PSPROBE_DIR" >/dev/null

"$HERDR_BIN" tab focus "$home_tab_id" >/dev/null
exec "$HERDR_BIN"
