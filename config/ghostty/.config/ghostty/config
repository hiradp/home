# Hirad's Ghostty Configuration
title = "👻"
command = "/opt/homebrew/bin/fish"
confirm-close-surface = false
shell-integration = fish

# Font settings
font-family = "Berkeley Mono"
font-family = "SF Mono"
font-size = 11
adjust-cell-height = 20%
# Berkeley Mono alternates: dotted zero, crossed 7, alternate r, broken bar.
font-feature = ss02
font-feature = ss04
font-feature = ss05
font-feature = ss06

# Window Settings
cursor-click-to-move = true
window-height = 100
window-width = 300
window-padding-x = 8
window-padding-y = 8
# herdr holds the state and `desk` rebuilds it; restored windows are dead shells.
window-save-state = never

# MacOS specific settings
macos-option-as-alt = left

# Send Shift+Enter as Pi's Ctrl+J multiline-input alias.
keybind = shift+enter=text:\n

# Pass Cmd+1..9 through to Herdr instead of switching Ghostty tabs.
keybind = super+digit_1=unbind
keybind = super+1=unbind
keybind = super+digit_2=unbind
keybind = super+2=unbind
keybind = super+digit_3=unbind
keybind = super+3=unbind
keybind = super+digit_4=unbind
keybind = super+4=unbind
keybind = super+digit_5=unbind
keybind = super+5=unbind
keybind = super+digit_6=unbind
keybind = super+6=unbind
keybind = super+digit_7=unbind
keybind = super+7=unbind
keybind = super+digit_8=unbind
keybind = super+8=unbind
keybind = super+digit_9=unbind
keybind = super+9=unbind

# Background
background-blur = true
background-opacity = 0.95
