# Hirad's Ghostty Configuration
title = "👻"
command = "/opt/homebrew/bin/fish"
confirm-close-surface = false
shell-integration = fish

# Font settings
font-family = "SF Mono"
font-size = 10
adjust-cell-height = 20%

# Window Settings
cursor-click-to-move = true
window-height = 100
window-width = 300
window-padding-x = 8
window-padding-y = 8
window-save-state = always

# MacOS specific settings
macos-option-as-alt = left

# Send Shift+Enter as Pi's Ctrl+J multiline-input alias.
keybind = shift+enter=text:\n

# Colors for my eyes
background-blur = true
background-opacity = 0.80
theme = light:Gruvbox Light Hard,dark:Builtin Pastel Dark
