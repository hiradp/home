# Hirad's Ghostty Configuration
title = "👻"
command = "/opt/homebrew/bin/fish"
confirm-close-surface = false
shell-integration = fish

# Font settings
font-family = "Berkeley Mono"
font-family = "SF Mono"
font-size = 11
adjust-cell-height = 20%
# Berkeley Mono alternates: dotted zero, crossed 7, alternate r, broken bar.
font-feature = ss02
font-feature = ss04
font-feature = ss05
font-feature = ss06

# Window Settings
cursor-click-to-move = true
window-height = 100
window-width = 300
window-padding-x = 8
window-padding-y = 8
# herdr holds the state and `desk` rebuilds it; restored windows are dead shells.
window-save-state = never

# MacOS specific settings
macos-option-as-alt = left

# Send Shift+Enter as Pi's Ctrl+J multiline-input alias.
keybind = shift+enter=text:\n

# Background
background-blur = true
background-opacity = 0.95

# Follow macOS light/dark appearance
theme = light:Tomorrow,dark:Tomorrow Night
