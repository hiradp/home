{
  "lastChangelogVersion": "0.84.1",
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "xhigh",
  "quietStartup": true,
  "editorPaddingX": 1,
  "guardrails": {
    "commands": {
      "blocked": [
        "wrangler"
      ]
    },
    "defaultBranch": {
      "allowed": [
        "hiradp/*"
      ]
    },
    "paths": {
      "blocked": [
        ".git",
        ".git/**",
        "~/.ssh"
      ],
      "confirm": [
        ".env",
        ".env.*",
        ".pi",
        ".pi/**",
        "~/.ssh/**"
      ]
    },
    "semanticReview": {
      "enabled": true,
      "mode": "enforce",
      "model": "openai-codex/gpt-5.6-luna",
      "timeoutMs": 15000,
      "commands": [
        "aws",
        "docker push",
        "gcloud",
        "gh",
        "git push",
        "npm publish",
        "pnpm publish",
        "pulumi",
        "terraform",
        "pskube",
        "k",
        "kubectl"
      ],
      "paths": [
        ".github/workflows",
        ".github/workflows/**",
        ".circleci",
        ".circleci/**",
        ".gitlab-ci.yml"
      ]
    },
    "kubectl": {
      "invocations": [
        {
          "command": "kubectl"
        },
        {
          "command": "k"
        },
        {
          "command": "pskube",
          "skipArguments": 1
        }
      ],
      "allowedCommands": [
        "api-resources",
        "api-versions",
        "auth can-i",
        "auth whoami",
        "completion",
        "config current-context",
        "config get-contexts",
        "config view",
        "describe",
        "explain",
        "get",
        "help",
        "logs",
        "options",
        "rollout history",
        "rollout status",
        "top",
        "version",
        "wait"
      ]
    }
  },
  "tuiMode": "fullscreen"
}